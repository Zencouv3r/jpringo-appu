{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ringo",
  "version": "0.1.0",
  "identifier": "app.ringo.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ringo",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/whisper-cli"
    ],
    "resources": {
      "binaries/*.dll": "",
      "../models/*.bin": "models/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
